# ─── Database (SQLite) ────────────────────────────────────────────────
# IMPORTANT: Prisma resolves SQLite paths best as an ABSOLUTE path.
# After cloning, point this to the db/custom.db file inside the project:
#
#   Linux/macOS : DATABASE_URL="file:/home/YOU/weather/db/custom.db"
#   Windows     : DATABASE_URL="file:C:/projects/weather/db/custom.db"
#   Docker      : DATABASE_URL="file:/app/db/custom.db"
#
DATABASE_URL="file:/absolute/path/to/weather/db/custom.db"

# ─── AI Analysis (optional) ───────────────────────────────────────────
# The "تحلیل هوشمند" (AI analysis) feature needs a Z.ai API key.
# Create a file named `.z-ai-config` in the project root (NOT this .env):
#
#   {
#     "baseUrl": "https://api.z.ai/api/paas/v4",
#     "apiKey": "YOUR_Z_AI_API_KEY"
#   }
#
# Without it, every other feature works fine (all map & forecast data
# comes from keyless open APIs).
