generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model City {
  id        Int     @id @default(autoincrement())
  name      String
  province  String
  lat       Float
  lon       Float
  isCapital Boolean @default(false)

  @@unique([name, province])
  @@index([name])
  @@index([province])
}
